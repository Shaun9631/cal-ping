# Copy this file to .env and fill in ONE (or both) of these.

# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL
DISCORD_WEBHOOK_URL=

# Telegram: message @BotFather -> /newbot -> copy the token.
# Then send your bot any message and open https://api.telegram.org/bot<TOKEN>/getUpdates
# to find "chat":{"id": ...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
